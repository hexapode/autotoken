# Leave DEMO_MODE=true for an offline, scripted provider.
DEMO_MODE=true
PORT=3000
DATA_DIR=./data
# For live traffic, set DEMO_MODE=false and all three model names.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
ANSWER_MODEL=
ROUTER_MODEL=
LEARNER_MODEL=
# Optional automatic discovery after every N successfully recorded requests.
# Zero means invoke POST /learn manually.
LEARN_EVERY=0

# Separate Pi recording proxy (npm run proxy), no learning/substitution.
# Uses LLM_BASE_URL and LLM_API_KEY above; does not use DEMO_MODE.
PROXY_PORT=3001
# Choose a separate local secret; Pi sends this instead of your upstream key.
PROXY_TOKEN=
TRACE_DIR=./data/trajectories
PROXY_TIMEOUT_MS=300000
# Optional grouping defaults, override per request with X-M2C-* headers.
M2C_RUN_ID=
M2C_INSTANCE_ID=
M2C_SESSION_ID=
